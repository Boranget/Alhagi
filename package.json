{
  "name": "alhagi",
  "version": "1.0.0",
  "description": "顾念笔记 - 基于 Milkdown 的现代化 Markdown 编辑器",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "chcp 65001 && vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@milkdown/crepe": "^7.5.0",
    "@milkdown/kit": "^7.21.0",
    "@milkdown/plugin-clipboard": "^7.21.1",
    "@uiw/codemirror-theme-eclipse": "^4.25.9",
    "@uiw/codemirror-theme-nord": "^4.25.9",
    "@vscode/ripgrep": "^1.18.0",
    "@vueuse/core": "^10.9.0",
    "electron-store": "^11.0.2",
    "html2canvas": "^1.4.1",
    "pinia": "^2.1.7",
    "prosemirror-search": "^1.1.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "prettier": "^3.2.5",
    "sass": "^1.72.0",
    "typescript": "^5.4.3",
    "vite": "^8.0.13",
    "vite-plugin-electron": "^1.0.0-beta.11",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue-tsc": "^2.0.7"
  },
  "build": {
    "appId": "com.alhagi.app",
    "productName": "Alhagi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
